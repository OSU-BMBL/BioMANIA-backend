import numpy as np
import matplotlib.pyplot as plt

# Define mean and covariance matrix
mean = [0, 0]  # Centered at origin
cov = [[1, -1], [-1, 1]]  # Moderate correlation

# Generate 1000 samples
samples = np.random.multivariate_normal(mean, cov, size=1000)

# Scatter plot to visualize
plt.scatter(samples[:, 0], samples[:, 1], alpha=0.5, edgecolors='k')
plt.xlabel('X-axis')
plt.ylabel('Y-axis')
plt.title('Multivariate Normal Distribution (2D)')
plt.show()



